# Telegram Bot API token from @BotFather
TELEGRAM_BOT_TOKEN=
# Telegram user id of the owner. Empty = the first person who writes /start becomes the owner.
OWNER_TELEGRAM_ID=
# Google AI Studio key (aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# Cloudflare Workers AI (dash.cloudflare.com → AI → REST API)
CF_ACCOUNT_ID=
CF_API_TOKEN=
# IANA timezone used until the owner sets another one in chat
DEFAULT_TIMEZONE=Asia/Almaty
# Where SQLite db and generated files live
DATA_DIR=./data
